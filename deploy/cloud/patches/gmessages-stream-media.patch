index 0000000..fea6ca6
--- /dev/null
+++ b/pkg/libgm/crypto/aesgcmencryptstream_test.go
@@ -0,0 +1,59 @@
+package crypto
+
+import (
+	"bytes"
+	"crypto/rand"
+	"io"
+	"testing"
+)
+
+func TestEncryptStreamMatchesEncryptData(t *testing.T) {
+	helper, err := NewAESGCMHelper(GenerateKey(32))
+	if err != nil {
+		t.Fatal(err)
+	}
+	chunk := outgoingRawChunkSize - 28
+	for _, size := range []int{0, 1, chunk - 1, chunk, chunk + 1, 3 * chunk, 3*chunk + 7, 1_000_003} {
+		data := make([]byte, size)
+		_, _ = rand.Read(data)
+		whole, err := helper.EncryptData(data)
+		if err != nil {
+			t.Fatal(err)
+		}
+		streamed, err := io.ReadAll(helper.EncryptStream(bytes.NewReader(data), int64(size)))
+		if err != nil {
+			t.Fatalf("size %d: %v", size, err)
+		}
+		if len(streamed) != len(whole) || int64(len(streamed)) != helper.EncryptedSize(int64(size)) {
+			t.Fatalf("size %d: streamed %d bytes, EncryptData %d, EncryptedSize %d", size, len(streamed), len(whole), helper.EncryptedSize(int64(size)))
+		}
+		if !bytes.Equal(streamed[:2], whole[:2]) {
+			t.Fatalf("size %d: header %v, want %v", size, streamed[:2], whole[:2])
+		}
+		// The nonces are random, so the bytes differ; what each decrypts to may not.
+		decrypted, err := helper.DecryptData(streamed)
+		if err != nil {
+			t.Fatalf("size %d: DecryptData: %v", size, err)
+		}
+		if !bytes.Equal(decrypted, data) {
+			t.Fatalf("size %d: DecryptData gave different data", size)
+		}
+		if size > 0 {
+			viaStream, err := io.ReadAll(helper.DecryptStream(io.NopCloser(bytes.NewReader(streamed))))
+			if err != nil {
+				t.Fatalf("size %d: DecryptStream: %v", size, err)
+			}
+			if !bytes.Equal(viaStream, data) {
+				t.Fatalf("size %d: DecryptStream gave different data", size)
+			}
+		}
+	}
+}
+
+func TestEncryptStreamFailsOnShortSource(t *testing.T) {
+	helper, _ := NewAESGCMHelper(GenerateKey(32))
+	_, err := io.ReadAll(helper.EncryptStream(bytes.NewReader(make([]byte, 10)), 11))
+	if err == nil {
+		t.Fatal("expected an error for a source shorter than its size")
+	}
+}
