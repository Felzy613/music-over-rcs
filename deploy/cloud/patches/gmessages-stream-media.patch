 func (gc *GMClient) reuploadMedia(ctx context.Context, content *event.MessageEventContent) (*gmproto.MediaContent, error) {
+	// A voice message may be converted, which needs it in memory; anything else goes through a file on disk and is
+	// encrypted as it is sent, so a big file is never held in memory, whole or encrypted.
+	if content.MsgType == event.MsgAudio && content.MSC3245Voice != nil {
+		return gc.reuploadMediaInMemory(ctx, content)
+	}
+	fileName := content.Body
+	if content.FileName != "" {
+		fileName = content.FileName
+	}
+	var resp *gmproto.MediaContent
+	var uploadErr error
+	// Where a big file's time goes (the bot's timelines read this line): reading it from the homeserver, then
+	// encrypting it and sending it to Google.
+	start := time.Now()
+	err := gc.Main.br.Bot.DownloadMediaToFile(ctx, content.URL, content.File, false, func(file *os.File) error {
+		info, err := file.Stat()
+		if err != nil {
+			return err
+		}
+		if content.Info.MimeType == "" {
+			head := make([]byte, 512)
+			n, _ := io.ReadFull(file, head)
+			content.Info.MimeType = http.DetectContentType(head[:n])
+			if _, err = file.Seek(0, io.SeekStart); err != nil {
+				return err
+			}
+		}
+		fetched := time.Now()
+		resp, uploadErr = gc.Client.UploadMediaStream(file, info.Size(), fileName, content.Info.MimeType)
+		zerolog.Ctx(ctx).Info().Msgf("media to Google: %.1f MB, homeserver %.1fs, encrypt+upload %.1fs",
+			float64(info.Size())/(1<<20), fetched.Sub(start).Seconds(), time.Since(fetched).Seconds())
+		return uploadErr
+	})
+	if uploadErr != nil {
+		return nil, fmt.Errorf("%w: %w", bridgev2.ErrMediaReuploadFailed, uploadErr)
+	} else if err != nil {
+		return nil, fmt.Errorf("%w: %w", bridgev2.ErrMediaDownloadFailed, err)
+	}
+	return resp, nil
+}
+
+func (gc *GMClient) reuploadMediaInMemory(ctx context.Context, content *event.MessageEventContent) (*gmproto.MediaContent, error) {
 	data, err := gc.Main.br.Bot.DownloadMedia(ctx, content.URL, content.File)
 	if err != nil {
 		return nil, fmt.Errorf("%w: %w", bridgev2.ErrMediaDownloadFailed, err)
diff --git a/pkg/libgm/crypto/aesgcmencryptstream.go b/pkg/libgm/crypto/aesgcmencryptstream.go
new file mode 100644
index 0000000..e7c9488
--- /dev/null
+++ b/pkg/libgm/crypto/aesgcmencryptstream.go
@@ -0,0 +1,68 @@
+package crypto
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"math"
+)
+
+// EncryptedSize is how long EncryptData's output is for size bytes of data, known before anything is encrypted.
+func (c *AESGCMHelper) EncryptedSize(size int64) int64 {
+	chunkOverhead := int64(c.gcm.NonceSize() + c.gcm.Overhead())
+	chunkSize := int64(outgoingRawChunkSize) - chunkOverhead
+	chunkCount := (size + chunkSize - 1) / chunkSize
+	return 2 + size + chunkOverhead*chunkCount
+}
+
+// EncryptStream is EncryptData for size bytes read from source: the same format, made one chunk at a time as it is read,
+// so the data is never held whole (a file of 100 MB is encrypted with a buffer of one chunk). It reads exactly size
+// bytes, and fails if source has fewer.
+func (c *AESGCMHelper) EncryptStream(source io.Reader, size int64) io.Reader {
+	return &AESGCMEncryptStream{
+		crypto:  c,
+		source:  source,
+		size:    size,
+		pending: []byte{0, byte(math.Log2(float64(outgoingRawChunkSize)))},
+	}
+}
+
+type AESGCMEncryptStream struct {
+	crypto     *AESGCMHelper
+	source     io.Reader
+	size       int64
+	read       int64
+	chunkIndex uint32
+	buf        []byte
+	pending    []byte
+}
+
+var _ io.Reader = (*AESGCMEncryptStream)(nil)
+
+func (s *AESGCMEncryptStream) Read(p []byte) (int, error) {
+	for len(s.pending) == 0 {
+		if s.read >= s.size {
+			return 0, io.EOF
+		}
+		chunkSize := int64(outgoingRawChunkSize - s.crypto.gcm.NonceSize() - s.crypto.gcm.Overhead())
+		if s.buf == nil {
+			s.buf = make([]byte, chunkSize)
+		}
+		chunk := s.buf[:min(chunkSize, s.size-s.read)]
+		_, err := io.ReadFull(s.source, chunk)
+		if errors.Is(err, io.EOF) {
+			err = io.ErrUnexpectedEOF
+		}
+		if err != nil {
+			return 0, fmt.Errorf("failed to read chunk #%d: %w", s.chunkIndex+1, err)
+		}
+		// The same rule as EncryptData: the chunk that reaches the end (a full one, when the size is a multiple) is the last.
+		isLastChunk := s.read+chunkSize >= s.size
+		s.pending = s.crypto.encryptChunk(chunk, s.crypto.calculateAAD(s.chunkIndex, isLastChunk))
+		s.read += int64(len(chunk))
+		s.chunkIndex++
+	}
+	n := copy(p, s.pending)
+	s.pending = s.pending[n:]
+	return n, nil
+}
diff --git a/pkg/libgm/crypto/aesgcmencryptstream_test.go b/pkg/libgm/crypto/aesgcmencryptstream_test.go
