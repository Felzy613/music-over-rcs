diff --git a/pkg/libgm/media_stream_test.go b/pkg/libgm/media_stream_test.go
new file mode 100644
index 0000000..a223b09
--- /dev/null
+++ b/pkg/libgm/media_stream_test.go
@@ -0,0 +1,117 @@
+package libgm
+
+import (
+	"bytes"
+	"crypto/rand"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/rs/zerolog"
+	"google.golang.org/protobuf/proto"
+
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/crypto"
+	"go.mau.fi/mautrix-gmessages/pkg/libgm/gmproto"
+)
+
+type seenUpload struct {
+	command          string
+	headers          http.Header
+	contentLength    int64
+	transferEncoding []string
+	body             []byte
+}
+
+// A stand-in for Google's upload server, reached by rewriting every request's address to it.
+func fakeUploadServer(t *testing.T) (*Client, func() []seenUpload) {
+	var mu sync.Mutex
+	var seen []seenUpload
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		mu.Lock()
+		seen = append(seen, seenUpload{r.Header.Get("x-goog-upload-command"), r.Header.Clone(), r.ContentLength, r.TransferEncoding, body})
+		mu.Unlock()
+		if r.Header.Get("x-goog-upload-command") == "start" {
+			w.Header().Set("x-goog-upload-chunk-granularity", "262144")
+			w.Header().Set("x-goog-upload-url", "https://instantmessaging-pa.googleapis.com/upload?upload_id=test")
+			return
+		}
+		out, _ := proto.Marshal(&gmproto.UploadMediaResponse{Media: &gmproto.UploadedMedia{MediaID: "media-1", MediaNumber: 1}})
+		_, _ = w.Write(out)
+	}))
+	t.Cleanup(server.Close)
+	target, _ := url.Parse(server.URL)
+	client := &Client{AuthData: NewAuthData(), Logger: zerolog.Nop(), http: &http.Client{Transport: rewrite{target}}}
+	return client, func() []seenUpload {
+		mu.Lock()
+		defer mu.Unlock()
+		out := seen
+		seen = nil
+		return out
+	}
+}
+
+type rewrite struct{ target *url.URL }
+
+func (r rewrite) RoundTrip(req *http.Request) (*http.Response, error) {
+	req = req.Clone(req.Context())
+	req.URL.Scheme = r.target.Scheme
+	req.URL.Host = r.target.Host
+	return http.DefaultTransport.RoundTrip(req)
+}
+
+func TestUploadMediaStreamSendsWhatUploadMediaSends(t *testing.T) {
+	client, seen := fakeUploadServer(t)
+	data := make([]byte, 3*(1<<15)+12345)
+	_, _ = rand.Read(data)
+
+	whole, err := client.UploadMedia(data, "Album.zip", "application/zip")
+	if err != nil {
+		t.Fatal(err)
+	}
+	wholeRequests := seen()
+	streamed, err := client.UploadMediaStream(bytes.NewReader(data), int64(len(data)), "Album.zip", "application/zip")
+	if err != nil {
+		t.Fatal(err)
+	}
+	streamedRequests := seen()
+
+	if len(wholeRequests) != 2 || len(streamedRequests) != 2 {
+		t.Fatalf("got %d and %d requests, want 2 each", len(wholeRequests), len(streamedRequests))
+	}
+	for i := range wholeRequests {
+		a, b := wholeRequests[i], streamedRequests[i]
+		if a.command != b.command || a.contentLength != b.contentLength || len(a.body) != len(b.body) || strings.Join(b.transferEncoding, ",") != "" {
+			t.Fatalf("request %d differs: %q %d %d %v, streamed %q %d %d %v", i, a.command, a.contentLength, len(a.body), a.transferEncoding, b.command, b.contentLength, len(b.body), b.transferEncoding)
+		}
+		for name := range a.headers {
+			if name == "X-Goog-Upload-Header-Content-Length" || name == "Content-Length" || name == "Content-Type" || strings.HasPrefix(name, "X-Goog-Upload") {
+				if a.headers.Get(name) != b.headers.Get(name) {
+					t.Fatalf("request %d header %s: %q, streamed %q", i, name, a.headers.Get(name), b.headers.Get(name))
+				}
+			}
+		}
+	}
+	if whole.Size != streamed.Size || whole.MediaName != streamed.MediaName || whole.Format != streamed.Format || whole.MediaID != streamed.MediaID || whole.MimeType != streamed.MimeType {
+		t.Fatalf("media content differs: %v, streamed %v", whole, streamed)
+	}
+	// What was uploaded decrypts, with the key the message carries, to the file.
+	helper, err := crypto.NewAESGCMHelper(streamed.DecryptionKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decrypted, err := helper.DecryptData(streamedRequests[1].body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decrypted, data) {
+		t.Fatal("the streamed upload does not decrypt to the file")
+	}
+}
