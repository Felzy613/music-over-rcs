# --- RCS for Business agent (only needed for `npm start`, `invite-tester`, `send-test`) ---
RBM_AGENT_ID=your_agent_id@rbm.goog
# The region you picked when you created the agent: us | europe | asia
RBM_REGION=us
# The client token you enter when you register the webhook in the Developer Console
RBM_CLIENT_TOKEN=
# Path to the service account key downloaded from your partner account (keep it out of git)
GOOGLE_APPLICATION_CREDENTIALS=keys/rbm-service-account.json

# Required only if the console says your agent is "multi-use"; otherwise leave unset.
# One of: AUTHENTICATION | TRANSACTION | PROMOTION | SERVICEREQUEST | ACKNOWLEDGEMENT
# RBM_MESSAGE_TRAFFIC_TYPE=TRANSACTION

# Optional: only answer these phone numbers (comma-separated, E.164 format)
# ALLOWED_SENDERS=+15551234567

# --- Personal setup through the mautrix-gmessages bridge (`npm run matrix`; see docs/setup-mac.md) ---
# `npm run matrix-login` fills in the first two for you.
MATRIX_HOMESERVER=http://127.0.0.1:8008
MATRIX_ACCESS_TOKEN=
# The room the bridge made for your "message yourself" chat. Find it with: npm run matrix-rooms -- --phone <your number>
MATRIX_ROOM_ID=
# MATRIX_POLL_MS=1500

# --- Personal setup through Beeper Desktop (`npm run beeper`; an alternative to the bridge above) ---
# Beeper Desktop > Settings > Developers: turn on the Desktop API, then create a token under Approved connections.
BEEPER_ACCESS_TOKEN=
# The chat to watch. Find your "message yourself" chat with: npm run beeper-chats
BEEPER_CHAT_ID=
# BEEPER_API_URL=http://localhost:23373
# BEEPER_POLL_MS=1500
# Largest file to download and send, in MB (Google Messages allows about 100)
# MAX_DOWNLOAD_MB=100

# --- YouTube Music (the bridge and Beeper routes; see docs/youtube-music.md) ---
# When your catalog has no match the bot looks on YouTube Music, using the same app API as the Zemer app.
# Set to off to stop all use of it.
# YOUTUBE_MUSIC=off
# Results are always filtered by Zemer's artist list (no female singers), kept current while the bot runs.
# Which sources a search asks when the catalog has no match, in order. The first to find anything answers.
# SONG_SOURCES=youtube-music,music-table

# --- music-table.com and the library (the bridge and Beeper routes; see docs/library.md) ---
# music-table.com offers MP3 downloads on its release posts. Set to off to stop all use of it.
# MUSIC_TABLE=off
# The daily new-music message (names and album art, no songs), in this Mac's time. Set to off for none.
# DIGEST_TIME=09:00
# Disk space for songs kept ready (your most played, the newest, the most viewed, and every song you get), in MB.
# No limit unless you set one here; 0 keeps none.
# PREFETCH_MB=unlimited
# A folder (on an external drive, say) the kept songs move into whenever it's connected, sorted as Artist/Album/01 Title.mp3.
# They always download to this Mac first. Quotes are needed when the path has spaces.
# SONGS_ARCHIVE_DIR="/Volumes/Music Drive/Music/Music over RCS"
# No alerts for new songs by artists you follow in these hours (this Mac's time). Set to off to get them any time.
# QUIET_HOURS=22:00-07:00
# Seconds between audio files only; text lists are sent together.
# 0 or off for none.
# SONG_GAP_SECONDS=5
# Where the bridge listens, for the check that Google Messages is still logged in (bridge route only).
# BRIDGE_URL=http://127.0.0.1:29336
# Automatically restart the managed bridge after network loss or a reported delivery failure. Set to off to disable.
# BRIDGE_AUTO_RESTART=off

# --- Local ---
PORT=8787
CATALOG_DB=data/catalog.db

# --- Running in the cloud (Render + Cloudflare; see docs/cloud.md). These are set in Render's environment, not here ---
# SECRET_KEY, MATRIX_PASSWORD, ADMIN_TOKEN       made by render.yaml
# R2_ENDPOINT, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY   the bucket: database backups, the lease, and the alerts the Worker mails
# BOT_ENABLED=off                                keeps the bot from answering while you set it up
# ALLOW_IMPORT=1                                 allows the one-time upload of the Mac's catalog
# DOWNLOADS_AHEAD=1                              songs downloading at once (default 3); a small host holds each whole file in memory
# ONEDRIVE_CLIENT_ID                             saves every song sent to your OneDrive (an app folder); sign in on the /pair page
# ONEDRIVE_MAX_MB_PER_MONTH=1500                 the most to upload a month, or "unlimited" (uploads share the host's outbound traffic)
# BRIDGE_PIDFILE                                 where the host's supervisor writes the bridge's process id, for restarting it
